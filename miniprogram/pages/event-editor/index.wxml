<view wx:if="{{isDemo}}" class="demo-banner">开发演示 · 数据仅保存在本机</view>
<view class="page">
  <text class="section-title">发起一场共读</text><view><text class="tag">书籍讨论</text><text class="tag">免费线下活动</text></view>
  <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="empty">正在加载…</view>
  <block wx:if="{{organizer && !loading}}">
    <view wx:if="{{locked}}" class="notice small">已有成员报名，时间、地点和人数设置已锁定，可继续完善介绍。</view>
    <view class="field spaced"><text class="field-label">活动标题</text><input value="{{form.title}}" data-field="title" bindinput="input" maxlength="80" /></view>
    <view class="field"><text class="field-label">共读书籍</text><input value="{{form.book}}" data-field="book" bindinput="input" maxlength="60" /></view>
    <view class="field"><text class="field-label">书籍类别</text><picker range="{{categories}}" bindchange="category"><view class="picker-value">{{form.category}}</view></picker></view>
    <button class="quiet" bindtap="toggleDateInput">{{manualDates ? '使用日期选择器' : '直接输入日期时间'}}</button>
    <view wx:if="{{manualDates}}" class="muted small">日期格式：2026-10-25；时间格式：14:00。所有时间均为北京时间。</view>
    <view class="field"><text class="field-label">开始时间 · 北京时间</text><view class="field-row"><view><input wx:if="{{manualDates}}" value="{{form.startDate}}" data-field="startDate" bindinput="input" maxlength="10" disabled="{{locked}}" aria-label="开始日期" /><picker wx:else mode="date" value="{{form.startDate}}" data-field="startDate" disabled="{{locked}}" bindchange="input"><view class="picker-value">{{form.startDate}}</view></picker></view><view><input wx:if="{{manualDates}}" value="{{form.startTime}}" data-field="startTime" bindinput="input" maxlength="5" disabled="{{locked}}" aria-label="开始时间" /><picker wx:else mode="time" value="{{form.startTime}}" data-field="startTime" disabled="{{locked}}" bindchange="input"><view class="picker-value">{{form.startTime}}</view></picker></view></view></view>
    <view class="field"><text class="field-label">结束时间</text><view class="field-row"><view><input wx:if="{{manualDates}}" value="{{form.endDate}}" data-field="endDate" bindinput="input" maxlength="10" disabled="{{locked}}" aria-label="结束日期" /><picker wx:else mode="date" value="{{form.endDate}}" data-field="endDate" disabled="{{locked}}" bindchange="input"><view class="picker-value">{{form.endDate}}</view></picker></view><view><input wx:if="{{manualDates}}" value="{{form.endTime}}" data-field="endTime" bindinput="input" maxlength="5" disabled="{{locked}}" aria-label="结束时间" /><picker wx:else mode="time" value="{{form.endTime}}" data-field="endTime" disabled="{{locked}}" bindchange="input"><view class="picker-value">{{form.endTime}}</view></picker></view></view></view>
    <view class="field"><text class="field-label">报名截止时间</text><view class="field-row"><view><input wx:if="{{manualDates}}" value="{{form.deadlineDate}}" data-field="deadlineDate" bindinput="input" maxlength="10" disabled="{{locked}}" aria-label="报名截止日期" /><picker wx:else mode="date" value="{{form.deadlineDate}}" data-field="deadlineDate" disabled="{{locked}}" bindchange="input"><view class="picker-value">{{form.deadlineDate}}</view></picker></view><view><input wx:if="{{manualDates}}" value="{{form.deadlineTime}}" data-field="deadlineTime" bindinput="input" maxlength="5" disabled="{{locked}}" aria-label="报名截止时间" /><picker wx:else mode="time" value="{{form.deadlineTime}}" data-field="deadlineTime" disabled="{{locked}}" bindchange="input"><view class="picker-value">{{form.deadlineTime}}</view></picker></view></view></view>
    <view class="field"><text class="field-label">活动地点</text><input value="{{form.location}}" data-field="location" bindinput="input" disabled="{{locked}}" maxlength="160" placeholder="填写完整地点" /></view>
    <view class="field-row"><view class="field"><text class="field-label">最低读者人数</text><input type="number" value="{{form.minCapacity}}" data-field="minCapacity" bindinput="input" disabled="{{locked}}" /></view><view class="field"><text class="field-label">读者人数上限</text><input type="number" value="{{form.maxCapacity}}" data-field="maxCapacity" bindinput="input" disabled="{{locked}}" /></view></view>
    <view class="field"><text class="field-label">内容简介</text><textarea value="{{form.description}}" data-field="description" bindinput="input" maxlength="3000" placeholder="介绍这场活动想讨论什么" /></view>
    <view class="field"><text class="field-label">参加前准备 · 可选</text><textarea value="{{form.preparation}}" data-field="preparation" bindinput="input" maxlength="1500" placeholder="如阅读范围、希望大家带来的问题" /></view>
    <view class="actions"><button wx:if="{{!published}}" class="secondary" data-publish="false" bindtap="save" disabled="{{working}}">保存草稿</button><button class="primary" data-publish="true" bindtap="save" loading="{{working}}" disabled="{{working}}">{{published ? '保存修改' : '发布活动'}}</button></view>
  </block>
</view>
