 <view class="v2-node-view v2-intro-art"><text class="v2-node-text">hi</text><view class="v2-node-view">很高兴遇见<view class="v2-node-view">爱读书的你。</view></view></view>
 <view class="v2-node-view v2-eyebrow">WELCOME TO READ TOGETHER</view><view class="v2-node-view v2-display">一起共读<view class="v2-node-view">让阅读发生在生活里</view></view>
