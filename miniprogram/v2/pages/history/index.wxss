@import "../../theme.wxss";
.v2-history-hero{padding-bottom:52rpx}.v2-history-hero .v2-hero-title{margin-bottom:6rpx}.v2-history-carousel{height:360rpx;margin-top:30rpx}.v2-history-slide{height:100%;border-radius:22rpx;overflow:hidden;position:relative;background:#376e5b;color:#fff}.v2-history-slide-image{width:100%;height:100%;opacity:.8}.v2-history-slide-art{height:100%;background:linear-gradient(120deg,#346653,#88ae89);display:flex;align-items:center;justify-content:center;font-size:130rpx;color:#d6dfae}.v2-history-slide-caption{position:absolute;bottom:0;left:0;right:0;padding:58rpx 28rpx 42rpx;background:linear-gradient(transparent,rgba(23,55,41,.85))}.v2-history-slide-title{font-size:32rpx;font-weight:600;line-height:1.5;margin-top:8rpx}.v2-history-sheet{margin-top:-24rpx}.v2-history-timeline{margin-top:34rpx}.v2-history-entry{display:flex;gap:18rpx}.v2-history-date{width:90rpx;flex-shrink:0;color:#478773;text-align:center;font-size:25rpx;font-weight:600;position:relative}.v2-history-date:after{content:"";position:absolute;top:70rpx;bottom:0;width:2rpx;background:#dae6d6;left:45rpx}.v2-history-year{font-size:19rpx;color:#96a28e;font-weight:400}.v2-history-entry-body{flex:1;min-width:0}.v2-history-people{display:flex;align-items:center;gap:8rpx;min-height:44rpx;margin-bottom:14rpx}.v2-history-avatar{width:44rpx;height:44rpx;border:3rpx solid #fbfcf8;border-radius:50%;background:#dce9d5;color:#5c866b;font-size:16rpx;display:inline-flex;align-items:center;justify-content:center;overflow:hidden;margin-right:-17rpx}.v2-history-people-note{font-size:22rpx;color:#80917d;margin-left:18rpx}.v2-history-card{display:flex;gap:20rpx;background:#fff;border:1rpx solid #e7edde;padding:20rpx;border-radius:20rpx;margin-bottom:32rpx}.v2-history-thumb{width:150rpx;height:176rpx;flex-shrink:0;border-radius:10rpx;overflow:hidden}.v2-history-card .v2-event-title{font-size:28rpx;margin-bottom:10rpx}.v2-history-card .v2-meta{font-size:22rpx}.v2-history-photo-note{font-size:20rpx;color:#4b9075;margin-top:12rpx}.v2-history-content{flex:1;min-width:0}
