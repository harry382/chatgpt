<view class="v2-node-view v2 v2-form-page">
 <view wx:if="{{demo}}" class="v2-node-view v2-demo">开发演示 · 发布仅保存到本地</view>
 <view class="v2-node-view v2-eyebrow">{{ended ? 'KEEP OUR READING MEMORIES' : 'START A READING TOGETHER'}}</view>
 <view class="v2-node-view v2-display">{{ended ? '让相聚留下回响。' : contentOnly ? '把这场共读，介绍得更好。' : '让一次共读'}}<view wx:if="{{!contentOnly && !ended}}" class="v2-node-view">从你的想法开始。</view></view>
 <view wx:if="{{!contentOnly}}" class="v2-node-view v2-hint">本版支持线下书籍讨论，所有会员均可发起。时间均为北京时间。</view>
 <view wx:if="{{contentOnly}}" class="v2-node-view v2-hint">{{form.title}}<view class="v2-node-view">{{form.startDate}} {{form.startTime}} · {{form.location}}</view><view class="v2-node-view">{{locked ? '时间、地点和人数已锁定。可更新介绍、配图、流程和须知；现场照片在活动结束后上传。' : '本页更新介绍、配图、流程与须知。'}}</view></view>
 <view wx:if="{{ended}}" class="v2-node-view v2-recap-editor">
  <view class="v2-node-view v2-section">现场活动照片 <text class="v2-node-text v2-section-note">{{recapImages.length}} / 12</text></view>
  <view class="v2-node-view v2-muted v2-small">首张照片用作历史活动主题图。可移至前面调整顺序；保存后公开展示。</view>
  <view class="v2-node-view v2-photo-editor-grid">
   <view wx:for="{{recapImages}}" wx:key="assetId" class="v2-node-view v2-photo-editor-item"><image class="v2-node-image v2-photo-editor-thumb" src="{{item.url}}" mode="aspectFill" data-kind="recap" data-index="{{index}}" bindtap="previewImage"/><view class="v2-node-view v2-photo-editor-tools"><button class="v2-node-button v2-link" bindtap="moveImage" data-kind="recap" data-index="{{index}}" data-delta="-1" disabled="{{working || index === 0}}">前移</button><button class="v2-node-button v2-link v2-red" bindtap="removeImage" data-kind="recap" data-index="{{index}}" disabled="{{working}}">移除</button></view></view>
  </view>
  <button class="v2-node-button v2-light" data-kind="recap" bindtap="gallery" disabled="{{working || !ready || recapImages.length >= 12}}">＋ 上传现场照片</button>
  <view class="v2-node-view v2-field"><text class="v2-node-text">回顾文字（选填）</text><textarea class="v2-node-textarea" data-field="form.recapText" bindinput="field" value="{{form.recapText}}" maxlength="2000" placeholder="记下这次共读的收获与难忘片段"/></view>
 </view>
 <block wx:if="{{!contentOnly}}">
  <view class="v2-node-view v2-field"><text class="v2-node-text">活动主题 *</text><input class="v2-node-input" data-field="form.title" bindinput="field" value="{{form.title}}" maxlength="60" placeholder="给这次共读起个名字"/></view>
  <view class="v2-node-view v2-field"><text class="v2-node-text">对应书籍 *</text><input class="v2-node-input" data-field="form.book" bindinput="field" value="{{form.book}}" maxlength="60" placeholder="请输入书名"/></view>
  <view class="v2-node-view v2-two-col"><view class="v2-node-view v2-field"><text class="v2-node-text">活动分类</text><picker class="v2-node-picker" range="{{categories}}" value="{{categoryIndex}}" bindchange="category"><view class="v2-node-view v2-picker">{{form.category}} ▾</view></picker></view><view class="v2-node-view v2-field"><text class="v2-node-text">人数上限（含主持人）</text><input class="v2-node-input" data-field="form.capacity" bindinput="field" type="number" value="{{form.capacity}}" maxlength="3"/></view></view>
  <view class="v2-node-view v2-upload-row"><view class="v2-node-view v2-upload-box" bindtap="image"><image class="v2-node-image" wx:if="{{coverUrl}}" src="{{coverUrl}}" mode="aspectFit"/><view class="v2-node-view" wx:else>＋<view class="v2-node-view">上传书籍封面</view></view></view><view class="v2-node-view v2-muted v2-small">建议使用竖版书封。<view class="v2-node-view">请确认有权使用该图片。</view></view></view>
  <view class="v2-node-view v2-field"><text class="v2-node-text">开始时间 *</text><view class="v2-node-view v2-two-col"><picker class="v2-node-picker" mode="date" value="{{form.startDate}}" bindchange="field" data-field="form.startDate"><view class="v2-node-view v2-picker">{{form.startDate}} ▾</view></picker><picker class="v2-node-picker" mode="time" value="{{form.startTime}}" bindchange="field" data-field="form.startTime"><view class="v2-node-view v2-picker">{{form.startTime}} ▾</view></picker></view></view>
  <view class="v2-node-view v2-field"><text class="v2-node-text">结束时间 *</text><view class="v2-node-view v2-two-col"><picker class="v2-node-picker" mode="date" value="{{form.endDate}}" bindchange="field" data-field="form.endDate"><view class="v2-node-view v2-picker">{{form.endDate}} ▾</view></picker><picker class="v2-node-picker" mode="time" value="{{form.endTime}}" bindchange="field" data-field="form.endTime"><view class="v2-node-view v2-picker">{{form.endTime}} ▾</view></picker></view></view>
  <view class="v2-node-view v2-field"><text class="v2-node-text">报名截止 *</text><view class="v2-node-view v2-two-col"><picker class="v2-node-picker" mode="date" value="{{form.deadlineDate}}" bindchange="field" data-field="form.deadlineDate"><view class="v2-node-view v2-picker">{{form.deadlineDate}} ▾</view></picker><picker class="v2-node-picker" mode="time" value="{{form.deadlineTime}}" bindchange="field" data-field="form.deadlineTime"><view class="v2-node-view v2-picker">{{form.deadlineTime}} ▾</view></picker></view></view>
  <view class="v2-node-view v2-field"><text class="v2-node-text">活动地点 *</text><input class="v2-node-input" data-field="form.location" bindinput="field" value="{{form.location}}" placeholder="书店、咖啡馆或共读场地"/><button class="v2-node-button v2-link" bindtap="location">⌖ 在微信地图选择位置</button><input class="v2-node-input" data-field="form.address" bindinput="field" value="{{form.address}}" placeholder="详细地址 / 房间 / 到达提示"/><view class="v2-node-view v2-muted v2-small">{{form.latitude ? '已选地图位置，成员可打开导航' : '尚未选地图位置，暂不能直接导航'}}</view></view>
 </block>
 <view class="v2-node-view v2-field"><text class="v2-node-text">内容简介 *</text><textarea class="v2-node-textarea" data-field="form.description" bindinput="field" value="{{form.description}}" maxlength="4000" placeholder="介绍活动主题、适合的人群与阅读范围"/></view>
 <view class="v2-node-view v2-field"><text class="v2-node-text">简介配图（最多9张）</text><view class="v2-node-view v2-muted v2-small">按顺序展示在简介文字下方，可点击放大。</view>
  <view class="v2-node-view v2-photo-editor-grid"><view wx:for="{{descriptionImages}}" wx:key="assetId" class="v2-node-view v2-photo-editor-item"><image class="v2-node-image v2-photo-editor-thumb" src="{{item.url}}" mode="aspectFill" data-kind="description" data-index="{{index}}" bindtap="previewImage"/><view class="v2-node-view v2-photo-editor-tools"><button class="v2-node-button v2-link" bindtap="moveImage" data-kind="description" data-index="{{index}}" data-delta="-1" disabled="{{working || index === 0}}">前移</button><button class="v2-node-button v2-link v2-red" bindtap="removeImage" data-kind="description" data-index="{{index}}" disabled="{{working}}">移除</button></view></view></view>
  <button class="v2-node-button v2-light" data-kind="description" bindtap="gallery" disabled="{{working || !ready || descriptionImages.length >= 9}}">＋ 添加简介图片</button>
 </view>
 <view class="v2-node-view v2-field"><text class="v2-node-text">推荐语 & 备注</text><textarea class="v2-node-textarea" data-field="form.remarks" bindinput="field" value="{{form.remarks}}" maxlength="2000" placeholder="需要准备什么？场地是否有个人消费？"/></view>
 <view class="v2-node-view v2-field"><text class="v2-node-text">活动流程 *</text><textarea class="v2-node-textarea v2-agenda-editor" data-field="form.agenda" bindinput="field" value="{{form.agenda}}" maxlength="4000"/></view>
 <view class="v2-node-view v2-field"><text class="v2-node-text">活动须知（最多12条）</text><view class="v2-node-view v2-muted v2-small">预置须知可修改或移除，也可增加本场活动的特别提醒。</view>
  <view wx:for="{{notices}}" wx:key="key" class="v2-node-view v2-notice-editor"><view class="v2-node-view v2-row"><text class="v2-node-text v2-muted v2-small">须知 {{index + 1}}</text><button class="v2-node-button v2-link v2-red" bindtap="removeNotice" data-index="{{index}}" disabled="{{working}}">移除</button></view><input class="v2-node-input" value="{{item.title}}" maxlength="40" bindinput="noticeField" data-index="{{index}}" data-key="title" placeholder="须知标题"/><textarea class="v2-node-textarea" value="{{item.body}}" maxlength="500" bindinput="noticeField" data-index="{{index}}" data-key="body" placeholder="须知内容"/></view>
  <button class="v2-node-button v2-light" bindtap="addNotice" disabled="{{working || notices.length >= 12}}">＋ 新增须知</button>
 </view>
 <view wx:if="{{!contentOnly}}" class="v2-node-view v2-field"><text class="v2-node-text">现场签到口令 *</text><input class="v2-node-input" data-field="form.checkinCode" bindinput="field" value="{{form.checkinCode}}" type="number" maxlength="6"/><view class="v2-node-view v2-muted v2-small">六位数字，仅发起人可见。请到场后告知成员。</view></view>
 <view wx:if="{{uploadStatus}}" class="v2-node-view v2-hint">{{uploadStatus}}</view>
 <view wx:if="{{error}}" class="v2-node-view v2-error">{{error}}</view>
 <button wx:if="{{contentOnly}}" class="v2-node-button v2-primary" bindtap="save" disabled="{{working || !ready || cancelled}}" loading="{{working}}">{{ended ? '保存活动回顾' : '保存介绍与须知'}}</button>
 <view wx:else class="v2-node-view v2-two-col"><button class="v2-node-button v2-light" bindtap="save" data-publish="{{false}}" disabled="{{working || !ready}}">保存草稿</button><button class="v2-node-button v2-primary" bindtap="save" data-publish="{{true}}" disabled="{{working || !ready}}" loading="{{working}}">发布活动</button></view>
</view>
