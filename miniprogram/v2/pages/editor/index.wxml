<view class="v2-node-view v2 v2-form-page">
 <view wx:if="{{demo}}" class="v2-node-view v2-demo">开发演示 · 发布仅保存到本地</view><view class="v2-node-view v2-eyebrow">START A READING TOGETHER</view><view class="v2-node-view v2-display">让一次共读<view class="v2-node-view">从你的想法开始。</view></view>
 <view class="v2-node-view v2-hint">本版支持线下书籍讨论，所有会员均可发起。时间均为北京时间。</view><view wx:if="{{locked}}" class="v2-node-view v2-error">活动已有报名。为避免成员错过变更，本版暂不支持修改，请与书友确认后再取消或重新发起。</view>
 <view class="v2-node-view v2-field"><text class="v2-node-text">活动主题 *</text><input class="v2-node-input" data-field="form.title" bindinput="field" value="{{form.title}}" maxlength="60" placeholder="给这次共读起个名字"/></view>
 <view class="v2-node-view v2-field"><text class="v2-node-text">对应书籍 *</text><input class="v2-node-input" data-field="form.book" bindinput="field" value="{{form.book}}" maxlength="60" placeholder="请输入书名"/></view>
 <view class="v2-node-view v2-two-col"><view class="v2-node-view v2-field"><text class="v2-node-text">活动分类</text><picker class="v2-node-picker" range="{{categories}}" value="{{categoryIndex}}" bindchange="category"><view class="v2-node-view v2-picker">{{form.category}} ▾</view></picker></view><view class="v2-node-view v2-field"><text class="v2-node-text">人数上限（含主持人）</text><input class="v2-node-input" data-field="form.capacity" bindinput="field" type="number" value="{{form.capacity}}" maxlength="3"/></view></view>
 <view class="v2-node-view v2-upload-row"><view class="v2-node-view v2-upload-box" bindtap="image" data-kind="cover"><image class="v2-node-image" wx:if="{{coverUrl}}" src="{{coverUrl}}" mode="aspectFit"/><view class="v2-node-view" wx:else>＋<view class="v2-node-view">上传书籍封面</view></view></view><view class="v2-node-view v2-muted v2-small">建议使用竖版书封。<view class="v2-node-view">请确认有权使用该图片。</view><view class="v2-node-view">正式环境图片审核通过后展示。</view></view></view>
 <view class="v2-node-view v2-field"><text class="v2-node-text">开始时间 *</text><view class="v2-node-view v2-two-col"><picker class="v2-node-picker" mode="date" value="{{form.startDate}}" bindchange="field" data-field="form.startDate"><view class="v2-node-view v2-picker">{{form.startDate}} ▾</view></picker><picker class="v2-node-picker" mode="time" value="{{form.startTime}}" bindchange="field" data-field="form.startTime"><view class="v2-node-view v2-picker">{{form.startTime}} ▾</view></picker></view></view>
 <view class="v2-node-view v2-field"><text class="v2-node-text">结束时间 *</text><view class="v2-node-view v2-two-col"><picker class="v2-node-picker" mode="date" value="{{form.endDate}}" bindchange="field" data-field="form.endDate"><view class="v2-node-view v2-picker">{{form.endDate}} ▾</view></picker><picker class="v2-node-picker" mode="time" value="{{form.endTime}}" bindchange="field" data-field="form.endTime"><view class="v2-node-view v2-picker">{{form.endTime}} ▾</view></picker></view></view>
 <view class="v2-node-view v2-field"><text class="v2-node-text">报名截止 *</text><view class="v2-node-view v2-two-col"><picker class="v2-node-picker" mode="date" value="{{form.deadlineDate}}" bindchange="field" data-field="form.deadlineDate"><view class="v2-node-view v2-picker">{{form.deadlineDate}} ▾</view></picker><picker class="v2-node-picker" mode="time" value="{{form.deadlineTime}}" bindchange="field" data-field="form.deadlineTime"><view class="v2-node-view v2-picker">{{form.deadlineTime}} ▾</view></picker></view></view>
 <view class="v2-node-view v2-field"><text class="v2-node-text">活动地点 *</text><input class="v2-node-input" data-field="form.location" bindinput="field" value="{{form.location}}" placeholder="书店、咖啡馆或共读场地"/><button class="v2-node-button v2-link" bindtap="location">⌖ 在微信地图选择位置</button><input class="v2-node-input" data-field="form.address" bindinput="field" value="{{form.address}}" placeholder="详细地址 / 房间 / 到达提示"/><view class="v2-node-view v2-muted v2-small">{{form.latitude ? '已选地图位置，成员可打开导航' : '尚未选地图位置，暂不能直接导航'}}</view></view>
 <view class="v2-node-view v2-field"><text class="v2-node-text">内容简介 *</text><textarea class="v2-node-textarea" data-field="form.description" bindinput="field" value="{{form.description}}" maxlength="4000" placeholder="介绍活动主题、适合的人群与阅读范围"/></view>
 <view class="v2-node-view v2-field"><text class="v2-node-text">推荐语 & 备注</text><textarea class="v2-node-textarea" data-field="form.remarks" bindinput="field" value="{{form.remarks}}" maxlength="2000" placeholder="需要准备什么？场地是否有个人消费？"/></view>
 <view class="v2-node-view v2-field"><text class="v2-node-text">活动流程 *</text><textarea class="v2-node-textarea v2-agenda-editor" data-field="form.agenda" bindinput="field" value="{{form.agenda}}" maxlength="4000"/></view>
 <view class="v2-node-view v2-field"><text class="v2-node-text">活动微信群码（报名成功后可见）</text><button class="v2-node-button v2-light" bindtap="image" data-kind="group">{{groupAsset ? '已上传 · 点击替换' : '＋ 上传群二维码'}}</button><view class="v2-node-view v2-muted v2-small">请在群码失效前更新。未上传时会向已报名成员提示等待。</view></view>
 <view class="v2-node-view v2-field"><text class="v2-node-text">现场签到口令 *</text><input class="v2-node-input" data-field="form.checkinCode" bindinput="field" value="{{form.checkinCode}}" type="number" maxlength="6"/><view class="v2-node-view v2-muted v2-small">六位数字，仅发起人可见。请到场后告知成员。</view></view>
 <view wx:if="{{error}}" class="v2-node-view v2-error">{{error}}</view><view class="v2-node-view v2-two-col"><button class="v2-node-button v2-light" bindtap="save" data-publish="{{false}}" disabled="{{working || locked}}">保存草稿</button><button class="v2-node-button v2-primary" bindtap="save" data-publish="{{true}}" disabled="{{working || locked}}" loading="{{working}}">发布活动</button></view>
</view>
