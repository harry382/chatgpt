@import "../../theme.wxss";
.v2-photo-editor-grid{display:flex;flex-wrap:wrap;gap:18rpx;margin:22rpx 0}.v2-photo-editor-item{width:calc(50% - 9rpx);background:#f0f5ea;border-radius:16rpx;overflow:hidden}.v2-photo-editor-thumb{width:100%;height:210rpx;display:block}.v2-photo-editor-tools{display:flex;justify-content:space-around}.v2-photo-editor-tools .v2-node-button{font-size:22rpx;padding:15rpx 8rpx;margin:0;width:auto}.v2-notice-editor{padding:20rpx;margin:20rpx 0;background:#edf3e7;border:1rpx solid #e0e8d7;border-radius:18rpx}.v2-notice-editor .v2-node-textarea{height:180rpx;margin-top:14rpx}.v2-notice-editor .v2-node-button{width:auto;margin:0;font-size:22rpx}.v2-recap-editor{padding:26rpx 0;border-bottom:1rpx solid #e0e8d7}
