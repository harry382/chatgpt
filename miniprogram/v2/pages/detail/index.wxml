<view class="v2-node-view v2 v2-detail {{event.ended ? 'v2-past-detail' : ''}}">
 <view wx:if="{{demo}}" class="v2-node-view v2-demo">开发预览 · 活动与通知仅为本地演示</view>
 <view wx:if="{{loading && !event}}" class="v2-node-view v2-empty">正在翻开这场共读…</view>
 <view wx:if="{{error}}" class="v2-node-view v2-error">{{error}}</view>
 <block wx:if="{{event}}">
  <block wx:if="{{event.ended}}">
   <image wx:if="{{event.heroUrl}}" class="v2-node-image v2-past-hero" src="{{event.heroUrl}}" mode="aspectFill"/>
   <view wx:else class="v2-node-view v2-past-hero v2-past-art"><view class="v2-node-view v2-eyebrow">READ TOGETHER</view><view class="v2-node-view v2-past-art-title">{{event.book}}</view><text class="v2-node-text v2-past-art-circle">◯</text></view>
   <view class="v2-node-view v2-past-summary"><text class="v2-node-text v2-tag">共读回顾 · 已结束</text><view class="v2-node-view v2-past-title">{{event.title}}</view><view class="v2-node-view v2-past-time">{{event.fullLabel}} — {{event.endLabel}}</view><view class="v2-node-view v2-location v2-past-location" bindtap="location"><text class="v2-node-text v2-location-icon">⌖</text><view class="v2-node-view">{{event.location}}<view class="v2-node-view v2-muted v2-small">{{event.address || '点击打开地图'}}</view></view><text class="v2-node-text">↗</text></view>
    <view class="v2-node-view v2-row"><view class="v2-node-view v2-section">参与书友 <text class="v2-node-text v2-section-note">报名记录 {{event.count}}人</text></view></view>
    <scroll-view scroll-x="{{true}}" class="v2-past-members"><view wx:for="{{members}}" wx:key="id" class="v2-node-view v2-past-person"><image wx:if="{{item.avatarUrl}}" class="v2-node-image v2-member-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="v2-node-view v2-member-avatar">{{item.nickname}}</view><view class="v2-node-view v2-past-person-name">{{item.nickname}}</view><text wx:if="{{item.host}}" class="v2-node-text v2-tag">主持人</text><text wx:elif="{{item.checkedIn}}" class="v2-node-text v2-tag">已签到</text></view><view wx:if="{{!members.length}}" class="v2-node-view v2-muted v2-small">这场活动暂无报名记录。</view></scroll-view>
    <view class="v2-node-view v2-muted v2-small">发起人 · {{creator.nickname || event.creatorName}}</view>
   </view>
  </block>
  <view wx:else class="v2-node-view v2-detail-hero">
   <view class="v2-node-view v2-detail-top">
    <image wx:if="{{event.coverUrl}}" class="v2-node-image v2-detail-cover" src="{{event.coverUrl}}" mode="aspectFill"/>
    <view wx:else class="v2-node-view v2-detail-cover v2-book"><text class="v2-node-text v2-book-top">一起共读</text><text class="v2-node-text v2-book-name">{{event.book}}</text><view class="v2-node-view v2-book-art">◯</view><text class="v2-node-text v2-book-bottom">READ TOGETHER</text></view>
    <view class="v2-node-view v2-detail-summary"><view class="v2-node-view v2-event-tags"><text class="v2-node-text v2-tag">{{event.category}}</text><text class="v2-node-text v2-tag">线下</text><text class="v2-node-text v2-tag">{{event.statusLabel}}</text></view><view class="v2-node-view v2-detail-title">{{event.title}}</view><view class="v2-node-view v2-detail-meta">创建 · {{creator.nickname || event.creatorName}}</view><view class="v2-node-view v2-detail-meta">时间 · {{event.fullLabel}}</view><view class="v2-node-view v2-detail-meta">报名 · {{event.count}} / {{event.capacity}} 位书友</view></view>
   </view>
   <view class="v2-node-view v2-location" bindtap="location"><text class="v2-node-text v2-location-icon">⌖</text><view class="v2-node-view">{{event.location}}<view class="v2-node-view v2-caption">{{event.address || '点击打开微信地图导航'}}</view></view><text class="v2-node-text">↗</text></view>
   <view wx:if="{{event.status === 'cancelled'}}" class="v2-node-view v2-error">活动已取消：{{event.cancellationReason}}</view>
   <view class="v2-node-view v2-info-block">
    <view class="v2-node-view v2-section"><text class="v2-node-text v2-highlight">内容简介</text></view>
    <swiper wx:if="{{event.descriptionImages.length}}" class="v2-description-carousel" indicator-dots="{{event.descriptionImages.length > 1}}" indicator-color="rgba(49,139,119,.25)" indicator-active-color="#318b77" circular="{{event.descriptionImages.length > 1}}">
     <swiper-item wx:for="{{event.descriptionImages}}" wx:key="assetId"><image class="v2-node-image v2-description-image" src="{{item.url}}" mode="aspectFit" data-kind="description" data-index="{{index}}" bindtap="previewImage"/></swiper-item>
    </swiper>
    <view class="v2-node-view v2-text">{{event.description}}</view>
   </view>
   <view wx:if="{{event.remarks}}" class="v2-node-view v2-info-block"><view class="v2-node-view v2-section"><text class="v2-node-text v2-highlight">推荐语 & 备注</text></view><view class="v2-node-view v2-text">{{event.remarks}}</view></view>
  </view>
  <view class="v2-node-view v2-sheet">
   <view class="v2-node-view v2-tabs v2-detail-tabs"><text wx:if="{{event.ended}}" class="v2-node-text {{tab === 'recap' ? 'active' : ''}}" bindtap="tab" data-value="recap">详情</text><text wx:else class="v2-node-text {{tab === 'members' ? 'active' : ''}}" bindtap="tab" data-value="members">成员<text class="v2-node-text v2-tab-count">{{event.count}}</text></text><text class="v2-node-text {{tab === 'agenda' ? 'active' : ''}}" bindtap="tab" data-value="agenda">流程</text><text wx:if="{{!event.ended}}" class="v2-node-text {{tab === 'notices' ? 'active' : ''}}" bindtap="tab" data-value="notices">须知</text></view>
   <view wx:if="{{tab === 'recap' && event.ended}}" class="v2-node-view v2-recap">
    <view class="v2-node-view v2-section">现场活动照片</view><view wx:if="{{event.recapText}}" class="v2-node-view v2-text v2-recap-text">{{event.recapText}}</view>
    <image wx:for="{{event.recapImages}}" wx:key="assetId" class="v2-node-image v2-content-photo" src="{{item.url}}" mode="widthFix" lazy-load="{{true}}" data-kind="recap" data-index="{{index}}" bindtap="previewImage"/>
    <view wx:if="{{!event.recapImages.length}}" class="v2-node-view v2-empty v2-recap-empty"><view class="v2-node-view v2-empty-icon">▧</view>相聚已经发生，影像还在路上。<view class="v2-node-view v2-muted v2-small">{{canManage ? '你可以在下方上传现场照片。' : '等待发起人或管理员补充现场照片。'}}</view></view>
    <view class="v2-node-view v2-recap-original">
     <view class="v2-node-view v2-section">当时的共读主题</view>
     <swiper wx:if="{{event.descriptionImages.length}}" class="v2-description-carousel" indicator-dots="{{event.descriptionImages.length > 1}}" indicator-color="rgba(49,139,119,.25)" indicator-active-color="#318b77" circular="{{event.descriptionImages.length > 1}}">
      <swiper-item wx:for="{{event.descriptionImages}}" wx:key="assetId"><image class="v2-node-image v2-description-image" src="{{item.url}}" mode="aspectFit" data-kind="description" data-index="{{index}}" bindtap="previewImage"/></swiper-item>
     </swiper>
     <view class="v2-node-view v2-text">{{event.description}}</view>
    </view>
   </view>
   <view wx:if="{{tab === 'members' && !event.ended}}" class="v2-node-view"><view wx:for="{{members}}" wx:key="id" class="v2-node-view v2-member-row"><image wx:if="{{item.avatarUrl}}" class="v2-node-image v2-member-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="v2-node-view v2-member-avatar">{{item.nickname}}</view><view class="v2-node-view"><view class="v2-node-view">{{item.nickname}}<text wx:if="{{item.host}}" class="v2-node-text v2-pill">主持人</text></view><text class="v2-node-text v2-muted v2-small">{{item.bio || '很高兴与你一起共读。'}}</text></view><text wx:if="{{item.checkedIn}}" class="v2-node-text v2-tag">已签到</text></view><view wx:if="{{!members.length}}" class="v2-node-view v2-empty">成为第一位报名的书友吧。</view></view>
   <view wx:if="{{tab === 'agenda'}}" class="v2-node-view v2-agenda"><view class="v2-node-view v2-text">{{event.agenda}}</view><view wx:if="{{!event.ended}}" class="v2-node-view v2-hint">每位已报名成员均可申请主持人，由发起人确认。主持人引导交流与发言节奏，让每个人都被听见。</view></view>
   <view wx:if="{{tab === 'notices' && !event.ended}}" class="v2-node-view v2-activity-notices"><view class="v2-node-view v2-section">活动须知</view><view wx:for="{{event.notices}}" wx:key="key" class="v2-node-view v2-activity-notice"><view class="v2-node-view v2-notice-number">{{index + 1}}</view><view class="v2-node-view v2-notice-body"><view class="v2-node-view v2-notice-title">{{item.title}}</view><view class="v2-node-view v2-text">{{item.body}}</view></view></view><view wx:if="{{!event.notices.length}}" class="v2-node-view v2-empty">发起人尚未添加特别须知。</view></view>
   <view wx:if="{{registration.status === 'waitlist' && !event.closed}}" class="v2-node-view v2-hint">你已加入候补。名额空出时会按顺序自动递补，请留意“我的”中的站内通知。未授权微信订阅消息时，请返回小程序查看通知。</view>
   <button wx:if="{{templateId && registration.status === 'waitlist' && !event.closed}}" class="v2-node-button v2-light" bindtap="subscribe">接收候补结果微信提醒</button><view wx:if="{{registration.status === 'registered' && !event.ended}}" class="v2-node-view v2-success">✓ 报名成功 · 请提前查看地点、流程和须知</view>
   <view wx:if="{{canManage}}" class="v2-node-view v2-management"><view class="v2-node-view v2-section">发起人管理</view><view wx:if="{{!event.ended && event.status !== 'cancelled'}}" class="v2-node-view v2-hint">现场签到口令：{{management.checkinCode || '未设置'}}。请到场后告知书友。</view><view wx:if="{{!event.closed}}"><view wx:for="{{management.hosts}}" wx:key="id" class="v2-node-view v2-host-review"><text class="v2-node-text">{{item.profile.nickname}} 申请主持</text><button class="v2-node-button v2-link" data-id="{{item.userId}}" data-approved="{{true}}" bindtap="review">同意</button><button class="v2-node-button v2-link" data-id="{{item.userId}}" data-approved="{{false}}" bindtap="review">拒绝</button></view></view><view wx:if="{{event.status !== 'cancelled'}}" class="v2-node-view v2-management-actions"><button class="v2-node-button v2-light" bindtap="content">{{event.ended ? '上传照片 / 编辑回顾' : '编辑介绍、配图与须知'}}</button><button wx:if="{{!event.closed && !event.count && !event.waitCount}}" class="v2-node-button v2-link" bindtap="edit">编辑时间、地点与名额</button><button wx:if="{{!event.ended}}" class="v2-node-button v2-link v2-red" bindtap="cancelEvent">取消活动</button></view></view>
  </view>
  <view wx:if="{{event.ended || event.status === 'cancelled'}}" class="v2-node-view v2-action-bar v2-ended-bar"><button class="v2-node-button v2-action-icon" bindtap="share"><text class="v2-node-text">↗</text>转发</button><view class="v2-node-view">{{event.status === 'cancelled' ? '活动已取消' : '活动已结束 · 共读的时光仍在'}}</view></view>
  <view wx:else class="v2-node-view v2-action-bar"><button class="v2-node-button v2-action-icon" bindtap="share"><text class="v2-node-text">↗</text>转发</button><button class="v2-node-button v2-action-icon" bindtap="wait" disabled="{{working || event.closed || (!event.full && registration.status !== 'waitlist')}}"><text class="v2-node-text">♧</text>{{registration.status === 'waitlist' ? '退出候补' : '候补'}}</button><button class="v2-node-button v2-action-icon" bindtap="checkIn" disabled="{{working || registration.checkedAt}}"><text class="v2-node-text">✓</text>{{registration.checkedAt ? '已签到' : '签到'}}</button><button class="v2-node-button v2-host-button" bindtap="host" disabled="{{working || event.closed || hostRequest.status === 'pending'}}">{{hostRequest.status === 'pending' ? '申请中' : '成为主持人'}}</button><button class="v2-node-button v2-signup-button" bindtap="join" disabled="{{working || (event.closed && registration.status !== 'registered') || event.started}}">{{registration.status === 'registered' ? '取消报名' : registration.status === 'waitlist' ? '候补中' : '报名活动'}}</button></view>
 </block>
 <view wx:if="{{shareOpen}}" class="v2-node-view v2-overlay" bindtap="closeShare"><view class="v2-node-view v2-bottom-modal" catchtap="noop"><view class="v2-node-view v2-modal-handle"></view><view class="v2-node-view v2-section">把这场共读分享出去</view><view class="v2-node-view v2-share-grid"><button class="v2-node-button v2-share-item" open-type="share"><text class="v2-node-text">◉</text>发送给朋友</button><button class="v2-node-button v2-share-item" bindtap="timeline"><text class="v2-node-text">✳</text>分享到朋友圈</button><button class="v2-node-button v2-share-item" bindtap="copy"><text class="v2-node-text">▤</text>复制活动信息</button><button class="v2-node-button v2-share-item" bindtap="poster" loading="{{working}}"><text class="v2-node-text">▧</text>生成活动海报</button></view><view wx:if="{{error}}" class="v2-node-view v2-error">{{error}}</view><button class="v2-node-button v2-link" bindtap="closeShare">取消</button></view></view>
 <view wx:if="{{posterOpen}}" class="v2-node-view v2-overlay" bindtap="closePoster"><view class="v2-node-view v2-center-modal" catchtap="noop"><image src="{{posterPath}}" mode="widthFix" class="v2-node-image v2-poster-image"/><view wx:if="{{error}}" class="v2-node-view v2-error">{{error}}</view><view class="v2-node-view v2-two-col"><button class="v2-node-button v2-light" bindtap="savePoster">保存海报</button><button class="v2-node-button v2-primary" bindtap="sharePoster">分享图片</button></view><button class="v2-node-button v2-link" bindtap="closePoster">关闭</button></view></view><canvas type="2d" id="activityPoster" style="position:fixed;left:-9999px;width:360px;height:560px;"></canvas>
</view>
