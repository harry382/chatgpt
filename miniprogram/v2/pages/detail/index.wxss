gin-top:4rpx}.v2-notice-body{flex:1;min-width:0}.v2-notice-title{font-size:29rpx;font-weight:500;margin-bottom:10rpx}.v2-activity-notice .v2-text{font-size:25rpx;color:#81907b;line-height:1.85}.v2-management-actions{display:flex;flex-direction:column;gap:10rpx;margin-top:25rpx}.v2-ended-bar{gap:22rpx}.v2-ended-bar>.v2-node-view{flex:1;text-align:center;color:#73866a;font-size:25rpx}
